# Whitelist: everything is ignored unless allowed below.
/*
!/.gitignore
!/.github/
!/hooks/
!/scripts/
!/LICENSE
!/README.md
!/go.mod
!/go.sum
!/*.go
!/internal/
!/spec/
!/account/
!/dca/
!/tokens/
!/webhooks/
!/ws/
!/stream/

# Denies last (they win over the allows above).
.env*
*.env
*.key
*secret*
*keypair*
*.local.*
CLAUDE.md
CLAUDE.local.md
NEXT.md
.claude/
wiki/
